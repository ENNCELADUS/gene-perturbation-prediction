# Frozen benchmark membership is a small provenance manifest, not a data dump.
!configs/benchmarks/cell_line_geneeffect_226_split.csv
# Pinned single-cell atlas candidates (accession, ModelID, identifier per line), small provenance.
!configs/benchmarks/single_cell_atlas_candidates.csv
!configs/benchmarks/sl_screen_lines.csv
# SL study inventory (one row per study; one per study and line), small provenance.
!configs/benchmarks/sl_studies.csv
!configs/benchmarks/sl_study_lines.csv
!configs/benchmarks/sl_study_tables.csv
# Reviewed chemistry of each single-cell deposit (cell-state telemetry), small provenance.
!configs/benchmarks/single_cell_source_chemistry.csv
# Hand-authored provenance CSVs for paper tables (small, source-of-truth; not data dumps)
!docs/report/tables/*.csv
# The original lines' manifest (the 226 builder and the original-47 materializer read it).
!configs/benchmarks/provenance/phase_a_tx1_20260724/cell_line_manifest.csv
# Curated P1 diagnostic evidence (small comparison tables and summaries, source-of-truth for results)
!results/p1_response_pathway_diagnostics/evidence/**
# PIE reproduction comparison tables (small, the record of results/pie_reproduction/)
!results/pie_reproduction/*.csv
