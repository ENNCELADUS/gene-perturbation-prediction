vertex="1" parent="1"><mxGeometry x="840" y="460" width="950" height="400" as="geometry"/></mxCell><mxCell id="basal" value='Basal expression&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;cell line &lt;i&gt;c&lt;/i&gt;, 128 basal cells&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=0;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="200" height="90" as="geometry"/></mxCell><mxCell id="tx1" value='Tahoe Tx1-3B&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;frozen; &lt;i&gt;H&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt; &amp;isin; &amp;#8477;&lt;sup&gt;128&amp;times;2560&lt;/sup&gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#DDDDDD;strokeColor=#555555;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="190" height="90" as="geometry"/></mxCell><mxCell id="prot" value='Protein sequence&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;perturbed gene &lt;i&gt;g&lt;/i&gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=0;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="200" height="90" as="geometry"/></mxCell><mxCell id="esm" value='ESM-2&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;frozen; &lt;i&gt;e&lt;sub&gt;g&lt;/sub&gt;&lt;/i&gt; &amp;isin; &amp;#8477;&lt;sup&gt;1280&lt;/sup&gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#DDDDDD;strokeColor=#555555;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="310" y="260" width="190" height="90" as="geometry"/></mxCell><mxCell id="adapter" value='Perturbation adapter&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;MLP 1280 &amp;rarr; 512 &amp;rarr; 2024&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#77AADD;strokeColor=#4477AA;" vertex="1" parent="1"><mxGeometry x="590" y="260" width="210" height="90" as="geometry"/></mxCell><mxCell id="state" value='STATE transition model&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;ST-HVG-Replogle init; 64-cell windows&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#77AADD;strokeColor=#4477AA;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="250" height="90" as="geometry"/></mxCell><mxCell id="desc" value='Response descriptors&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;&amp;Delta;: 4000 &amp;rarr; 256 proj.; &lt;i&gt;s&lt;/i&gt;: 6 summaries&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#44BB99;strokeColor=#117733;" vertex="1" parent="1"><mxGeometry x="870" y="520" width="210" height="90" as="geometry"/></mxCell><mxCell id="concat" value="&amp;oplus;" style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;ellipse;fillColor=#FFFFFF;strokeColor=#333333;fontSize=26;" vertex="1" parent="1"><mxGeometry x="1180" y="535" width="60" height="60" as="geometry"/></mxCell><mxCell id="head" value='GeneEffect head&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;MLP 6668 &amp;rarr; 256 &amp;rarr; 256 &amp;rarr; 1&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#77AADD;strokeColor=#4477AA;" vertex="1" parent="1"><mxGeometry x="1310" y="520" width="210" height="90" as="geometry"/></mxCell><mxCell id="out" value='GeneEffect(&lt;i&gt;g&lt;/i&gt;, &lt;i&gt;c&lt;/i&gt;)&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;&lt;i&gt;&amp;mu;&lt;/i&gt;&lt;sub&gt;train&lt;/sub&gt;(&lt;i&gt;g&lt;/i&gt;) + &lt;i&gt;&amp;delta;&amp;#770;&lt;/i&gt;(&lt;i&gt;g&lt;/i&gt;, &lt;i&gt;c&lt;/i&gt;)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#EEDD88;strokeColor=#DDAA33;" vertex="1" parent="1"><mxGeometry x="1560" y="520" width="210" height="90" as="geometry"/></mxCell><mxCell id="hvg" value='Basal HVG expression&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;&lt;i&gt;X&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt; &amp;isin; &amp;#8477;&lt;sup&gt;128&amp;times;2000&lt;/sup&gt;, matched cells&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=0;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="870" y="700" width="210" height="90" as="geometry"/></mxCell><mxCell id="cov" value='Fixed covariates&lt;br&gt;&lt;font style="font-size:14px;color:#333333"&gt;&lt;i&gt;q&lt;sub&gt;g,c&lt;/sub&gt;&lt;/i&gt; (3), &lt;i&gt;e&lt;sub&gt;g&lt;/sub&gt;&lt;/i&gt; (1280), &lt;i&gt;z&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt; (5120)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=0;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1110" y="700" width="200" height="90" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1" source="basal" target="tx1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="&lt;i&gt;H&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1" source="tx1" target="state"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1" source="prot" target="esm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="&lt;i&gt;e&lt;sub&gt;g&lt;/sub&gt;&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1" source="esm" target="adapter"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="&lt;i&gt;p&lt;sub&gt;g&lt;/sub&gt;&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=top;exitX=0.5;exitY=0;entryX=0.08;entryY=1;" edge="1" parent="1" source="adapter" target="state"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="4" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="state" target="desc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ylab" value="&lt;i&gt;&amp;Ycirc;&lt;sub&gt;g,c&lt;/sub&gt;&lt;/i&gt; &amp;isin; &amp;#8477;&lt;sup&gt;128&amp;times;2000&lt;/sup&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="985" y="418" width="220" height="24" as="geometry"/></mxCell><mxCell id="e7" value="&lt;i&gt;X&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;align=left;verticalAlign=middle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="hvg" target="desc"><mxGeometry relative="1" as="geometry"><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="&amp;Delta;&lt;sub&gt;proj&lt;/sub&gt;, &lt;i&gt;s&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1" source="desc" target="concat"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="+ 3 masks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;align=left;verticalAlign=middle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cov" target="concat"><mxGeometry relative="1" as="geometry"><mxPoint x="8" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="6668-d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1" source="concat" target="head"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="e11" value="&lt;i&gt;&amp;delta;&amp;#770;&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;strokeWidth=1.5;fontSize=16;fontColor=#222222;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;" edge="1" parent="1" source="head" target="out"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="lgt" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="52" width="100" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="" style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=0;fillColor=#FFFFFF;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1132" y="86" width="34" height="20" as="geometry"/></mxCell><mxCell id="lt0" value="Input / fixed tensor" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="83" width="200" height="26" as="geometry"/></mxCell><mxCell id="lg1" value="" style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#DDDDDD;strokeColor=#555555;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1132" y="118" width="34" height="20" as="geometry"/></mxCell><mxCell id="lt1" value="Frozen encoder" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="115" width="200" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="" style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#77AADD;strokeColor=#4477AA;" vertex="1" parent="1"><mxGeometry x="1132" y="150" width="34" height="20" as="geometry"/></mxCell><mxCell id="lt2" value="Trainable module" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="147" width="200" height="26" as="geometry"/></mxCell><mxCell id="lg3" value="" style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#44BB99;strokeColor=#117733;" vertex="1" parent="1"><mxGeometry x="1132" y="182" width="34" height="20" as="geometry"/></mxCell><mxCell id="lt3" value="Derived features" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="179" width="200" height="26" as="geometry"/></mxCell><mxCell id="lg4" value="" style="whiteSpace=wrap;html=1;fontSize=20;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;rounded=1;arcSize=15;fillColor=#EEDD88;strokeColor=#DDAA33;" vertex="1" parent="1"><mxGeometry x="1132" y="214" width="34" height="20" as="geometry"/></mxCell><mxCell id="lt4" value="Prediction" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="211" width="200" height="26" as="geometry"/></mxCell><mxCell id="nott" value="Notation" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1400" y="52" width="120" height="24" as="geometry"/></mxCell><mxCell id="note" value="&lt;i&gt;H&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt;: basal cell embeddings of line &lt;i&gt;c&lt;/i&gt;&lt;br&gt;&lt;i&gt;e&lt;sub&gt;g&lt;/sub&gt;&lt;/i&gt;, &lt;i&gt;p&lt;sub&gt;g&lt;/sub&gt;&lt;/i&gt;: protein embedding and perturbation token of gene &lt;i&gt;g&lt;/i&gt;&lt;br&gt;&lt;i&gt;X&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt;, &lt;i&gt;&amp;Ycirc;&lt;sub&gt;g,c&lt;/sub&gt;&lt;/i&gt;: basal and predicted post-perturbation HVG expression&lt;br&gt;&amp;Delta;, &lt;i&gt;s&lt;/i&gt;: mean/variance shift and scalar response summaries&lt;br&gt;&lt;i&gt;z&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt;: mean- and variance-pooled &lt;i&gt;H&lt;sub&gt;c&lt;/sub&gt;&lt;/i&gt;; &lt;i&gt;q&lt;sub&gt;g,c&lt;/sub&gt;&lt;/i&gt;: basal statistics of &lt;i&gt;g&lt;/i&gt; in &lt;i&gt;c&lt;/i&gt;&lt;br&gt;&lt;i&gt;&amp;mu;&lt;/i&gt;&lt;sub&gt;train&lt;/sub&gt;(&lt;i&gt;g&lt;/i&gt;): gene mean over the 170 labeled training lines" style="text;html=1;align=left;verticalAlign=top;fontColor=#222222;fontFamily=Helvetica;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1400" y="84" width="330" height="300" as="geometry"/></mxCell><mxCell id="obj" value="&lt;b&gt;Every update&lt;/b&gt; (dependency batch, all 170 labeled training lines):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;L&lt;/i&gt;&lt;sub&gt;dep&lt;/sub&gt; = Huber&lt;sub&gt;&amp;delta;=1&lt;/sub&gt;&amp;#8202;( &lt;i&gt;&amp;delta;&amp;#770;&lt;/i&gt;(&lt;i&gt;g&lt;/i&gt;, &lt;i&gt;c&lt;/i&gt;) &amp;minus; [GeneEffect(&lt;i&gt;g&lt;/i&gt;, &lt;i&gt;c&lt;/i&gt;) &amp;minus; &lt;i&gt;&amp;mu;&lt;/i&gt;&lt;sub&gt;train&lt;/sub&gt;(&lt;i&gt;g&lt;/i&gt;)] )&lt;br&gt;&lt;br&gt;&lt;b&gt;Every 4th update&lt;/b&gt; (+ balanced replay on four Perturb-seq anchor lines):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;L&lt;/i&gt; = &lt;i&gt;L&lt;/i&gt;&lt;sub&gt;dep&lt;/sub&gt; + &lt;i&gt;&amp;lambda;&lt;/i&gt;&amp;#8202;[ MSE(mean shift) + energy distance(&lt;i&gt;&amp;Ycirc;&lt;sub&gt;g,c&lt;/sub&gt;&lt;/i&gt;, &lt;i&gt;Y&lt;sub&gt;g,c&lt;/sub&gt;&lt;/i&gt;) ],&amp;nbsp; &lt;i&gt;&amp;lambda;&lt;/i&gt; = 1&lt;br&gt;&lt;br&gt;Trainable: STATE, adapter, head. Frozen: Tx1, ESM-2.&lt;br&gt;Head inputs use train-fitted standardization.&lt;br&gt;&lt;br&gt;Dependency batch: 1024 (&lt;i&gt;g&lt;/i&gt;, &lt;i&gt;c&lt;/i&gt;) conditions per rank; replay batch: 64 conditions, 16 from each anchor (K562, Jurkat, HepG2, HCT116).&lt;br&gt;AdamW; learning rates 10&lt;sup&gt;&amp;minus;6&lt;/sup&gt; (STATE), 10&lt;sup&gt;&amp;minus;5&lt;/sup&gt; (adapter), 10&lt;sup&gt;&amp;minus;4&lt;/sup&gt; (head); checkpoint and early stopping on validation Huber loss." style="text;html=1;align=left;verticalAlign=top;fontColor=#222222;fontFamily=Helvetica;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="720" height="350" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>